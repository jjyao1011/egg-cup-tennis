rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournament/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'jj1011@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
